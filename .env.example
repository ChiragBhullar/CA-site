# Copy to .env and load with your process manager / hosting panel.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=karsandco.in,www.karsandco.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://karsandco.in,https://www.karsandco.in

# Where new enquiries get emailed (comma separated)
CONTACT_NOTIFY_EMAILS=caanujsarav@gmail.com
DJANGO_FROM_EMAIL=website@karsandco.in

# SMTP — leave unset in development to print emails to the console
